# This is the only environment file used by the app and Docker services.
NODE_ENV=production
PORT=3002
APP_BIND_IP=0.0.0.0
# Desktop defaults to PUBLIC_URL in production and localhost:PORT locally.
# DESKTOP_CLIENT_URL=http://localhost:5173
# DESKTOP_HOME_SERVER=http://localhost:3002

# Public LibraCord origin. Use HTTPS in production.
CLIENT_ORIGIN=https://chat.example.com
PUBLIC_URL=https://chat.example.com
FEDERATION_DOMAIN=chat.example.com
ALLOW_PRIVATE_FEDERATION=false

# These paths are overridden to persistent volumes by Docker Compose.
DATABASE_PATH=data/libracord.db
UPLOADS_PATH=uploads

# The browser-facing LiveKit URL and shared credentials.
# Nginx Proxy Manager can proxy /rtc and /twirp on the same public hostname.
LIVEKIT_URL=wss://chat.example.com
LIVEKIT_INTERNAL_URL=ws://livekit:7880
LIVEKIT_API_KEY=libracord
LIVEKIT_API_SECRET=replace-with-at-least-32-random-characters
LIVEKIT_VERSION=latest
LIVEKIT_USE_EXTERNAL_IP=true
# Used when LIVEKIT_USE_EXTERNAL_IP=false. Replace with the server's public IP.
LIVEKIT_NODE_IP=
LIVEKIT_HTTP_BIND_IP=127.0.0.1
LIVEKIT_HTTP_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882
LIVEKIT_TURN_ENABLED=false
LIVEKIT_TURN_DOMAIN=turn.chat.example.com
LIVEKIT_TURN_UDP_PORT=3478
LIVEKIT_RTMP_URL=rtmp://chat.example.com:1935/live
LIVEKIT_WHIP_URL=https://chat.example.com/whip

# Optional services: docker compose --profile ingress --profile browser up -d
LIVEKIT_INGRESS_VERSION=latest
INGRESS_RTMP_PORT=1935
INGRESS_WHIP_PORT=8080
INGRESS_UDP_PORT=7885
BROWSER_DESKTOP_PORT=6080
BROWSER_DESKTOP_URL=https://chat.example.com/browser/vnc.html?autoconnect=true&resize=scale&path=browser/websockify

# Set this to a registry image to pull rather than naming the local build.
LIBRACORD_IMAGE=libracord:latest
